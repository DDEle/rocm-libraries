# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyIRVerifierPass --print-output 2>&1
#
# global_load_* / global_store_* have two addressing forms: a 32-bit VGPR offset plus an
# SGPR-pair base (saddr), or a 64-bit VGPR address with saddr off. Both must pass the
# AsmVerifierPass.

#--- saddr form: 32-bit offset in v0, 64-bit base in s[0:1]
# CHECK-NOT: [StinkyIRVerifier]
# CHECK-LABEL: @saddr_form
# CHECK: v1 = "st.global_load_b32"(v0, s[0:1])
# CHECK: v[2:3] = "st.global_load_b64"(v0, s[0:1])
# CHECK: "st.global_store_b32"(v0, v1, s[0:1])
# CHECK: "st.global_store_b64"(v0, v[2:3], s[0:1])
# CHECK: "st.global_store_b128"(v0, v[4:7], s[0:1])
st.func @saddr_form() {
^entry:
  v1 = "st.global_load_b32"(v0, s[0:1]) { issueCycles = 1, latencyCycles = 1 }
  v[2:3] = "st.global_load_b64"(v0, s[0:1]) { issueCycles = 1, latencyCycles = 1 }
  "st.global_store_b32"(v0, v1, s[0:1]) { issueCycles = 1, latencyCycles = 1 }
  "st.global_store_b64"(v0, v[2:3], s[0:1]) { issueCycles = 1, latencyCycles = 1 }
  "st.global_store_b128"(v0, v[4:7], s[0:1]) { issueCycles = 1, latencyCycles = 1 }
}

#--- saddr off: 64-bit address in v[8:9]
# CHECK-NOT: [StinkyIRVerifier]
# CHECK-LABEL: @saddr_off_form
# CHECK: v1 = "st.global_load_b32"(v[8:9], off)
# CHECK: v[2:3] = "st.global_load_b64"(v[8:9], off)
# CHECK: "st.global_store_b32"(v[8:9], v1, off)
# CHECK: "st.global_store_b64"(v[8:9], v[2:3], off)
# CHECK: "st.global_store_b128"(v[8:9], v[4:7], off)
st.func @saddr_off_form() {
^entry:
  v1 = "st.global_load_b32"(v[8:9], off) { issueCycles = 1, latencyCycles = 1 }
  v[2:3] = "st.global_load_b64"(v[8:9], off) { issueCycles = 1, latencyCycles = 1 }
  "st.global_store_b32"(v[8:9], v1, off) { issueCycles = 1, latencyCycles = 1 }
  "st.global_store_b64"(v[8:9], v[2:3], off) { issueCycles = 1, latencyCycles = 1 }
  "st.global_store_b128"(v[8:9], v[4:7], off) { issueCycles = 1, latencyCycles = 1 }
}
